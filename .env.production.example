# Copy to .env.production and fill in. .env.* is gitignored.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# --- required ---
DOMAIN=example.com
ACME_EMAIL=admin@example.com
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- optional, sane defaults in docker-compose.prod.yml ---
POSTGRES_DB=cashflow_online
POSTGRES_USER=cashflow
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# The variables below are set by docker-compose.prod.yml and are listed here
# only for a non-Docker deployment.
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
# DATABASE_URL=postgres://user:password@host:5432/database
#
# DATABASE_SSL: only for a database reached over an untrusted network.
# DATABASE_SSL_INSECURE=true disables certificate verification - that is TLS
# without authentication, so use it only against a known self-signed server.
# DATABASE_SSL=false
# DATABASE_SSL_INSECURE=false
#
# TRUST_PROXY: MUST be true behind a reverse proxy and false when the app is
# exposed directly. When false the X-Forwarded-For header is ignored, because
# an attacker could otherwise give every request its own rate-limit bucket.
# TRUST_PROXY=true
#
# PUBLIC_ORIGIN=https://example.com
# CORS_ORIGINS=https://example.com
# SESSION_COOKIE_SECURE=true
# EMAIL_DEV_MODE=false
#
# AUTH_RATE_WINDOW_MS=60000
# AUTH_RATE_MAX=12
# SESSION_MAX_AGE_MS=2592000000
# SESSION_IDLE_MS=604800000
# EMAIL_TOKEN_TTL_MS=86400000
# PASSWORD_RESET_TTL_MS=3600000
# WS_HEARTBEAT_MS=30000
# SHUTDOWN_TIMEOUT_MS=10000
# LOG_FORMAT=json
#
# Room memory and retention.
# ROOM_ACTIVE_WINDOW_MS: rooms idle longer than this are not loaded into memory
# on boot (they stay in Postgres).
# ROOM_ACTIVE_WINDOW_MS=2592000000
# ROOM_LOAD_LIMIT=500
# MAINTENANCE_INTERVAL_MS=10000
# CLEANUP_INTERVAL_MS=3600000
# SESSION_SWEEP_GRACE_MS=86400000
#
# BACKUP_DIR=backups
