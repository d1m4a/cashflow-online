{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Caddy proxies WebSocket upgrades natively; /ws needs no special block.
	reverse_proxy app:3000 {
		# The app trusts only the last hop, so overwrite rather than append:
		# a client-supplied X-Forwarded-For must never survive the proxy.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	log {
		output stdout
		format json
	}
}
